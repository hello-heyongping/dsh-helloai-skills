{
  "name": "@hello-heyongping/dsh-helloai-skills",
  "version": "1.3.0",
  "description": "A focused skills and repository manager for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-heyongping/dsh-helloai-skills.git"
  },
  "homepage": "https://github.com/hello-heyongping/dsh-helloai-skills#readme",
  "bugs": {
    "url": "https://github.com/hello-heyongping/dsh-helloai-skills/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "package.json", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["@deepseek-ai/dsh-client-ui-slots"], "platform": "web" } },
  "scripts": { "build": "node scripts/build.mjs", "typecheck": "tsc --noEmit", "selftest": "node scripts/selftest.mjs && node scripts/selftest-client.mjs", "selftest:catalog": "node scripts/selftest-catalog.mjs" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-skill": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": { "node": ">=20" }
}
